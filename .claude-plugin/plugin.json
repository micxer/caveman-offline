{
  "name": "caveman",
  "version": "1.0.0",
  "description": "Ultra-compressed output. Local instructions only — no network calls, no cloud gateway, no telemetry.",
  "author": {
    "name": "Michael Weinrich",
    "url": "https://github.com/micxer/caveman-offline"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/caveman-activate.js\"",
            "timeout": 30,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/caveman-mode-tracker.js\"",
            "timeout": 30,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ]
  }
}
